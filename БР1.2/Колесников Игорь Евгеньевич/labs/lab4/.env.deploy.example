# Generate the real .env.deploy with ./prepare-env.sh. Do not commit it.
JOBBY_DB_PASSWORD=replace_with_random_hex
JOBBY_RABBIT_USER=jobby
JOBBY_RABBIT_PASSWORD=replace_with_random_hex
JOBBY_INTERNAL_SECRET=replace_with_random_hex

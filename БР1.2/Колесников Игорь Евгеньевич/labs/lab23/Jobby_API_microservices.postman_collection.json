              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const city = pm.response.json().find(x => x.name === 'Санкт-Петербург'); pm.test('Город Санкт-Петербург найден', () => pm.expect(city).to.exist); pm.collectionVariables.set('city_id', city.id);"
